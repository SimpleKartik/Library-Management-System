@model LibraryManagement.Web.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<div class="row mt-4">
    <div class="col-md-4 text-center mb-4">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="~/images/books/@Model.ImageUrl" alt="@Model.Title" class="img-fluid img-thumbnail shadow" style="max-height: 450px;" />
        }
        else
        {
            <div class="bg-light border shadow-sm d-flex align-items-center justify-content-center mx-auto" style="width: 100%; height: 400px;">
                <h4 class="text-muted">No Cover Image</h4>
            </div>
        }
        
        <div class="mt-4 d-grid gap-2">
            @if (User.IsInRole("Student"))
            {
                if (Model.AvailableCopies > 0)
                {
                    <form asp-controller="BorrowRecords" asp-action="Borrow" method="post">
                        <input type="hidden" name="bookId" value="@Model.Id" />
                        <button type="submit" class="btn btn-primary btn-lg w-100">Borrow This Book</button>
                    </form>
                }
                else
                {
                    <button class="btn btn-secondary btn-lg w-100" disabled>Currently Unavailable</button>
                }
            }
        </div>
    </div>
    
    <div class="col-md-8">
        <h1 class="display-5 fw-bold text-dark">@Model.Title</h1>
        <h4 class="text-muted mb-4">By @Model.Author</h4>
        
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold text-muted">ISBN</div>
                    <div class="col-sm-8">@Model.ISBN</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold text-muted">Publisher</div>
                    <div class="col-sm-8">@Model.Publisher</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold text-muted">Availability</div>
                    <div class="col-sm-8">
                        @if (Model.AvailableCopies > 0)
                        {
                            <span class="badge bg-success fs-6">Available (@Model.AvailableCopies of @Model.TotalCopies)</span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6">Checked Out</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (User.IsInRole("Librarian"))
        {
            <div class="d-flex gap-2 mb-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fa fa-edit"></i> Edit Book</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>
            
            <h4 class="mt-4 border-bottom pb-2">Borrow History</h4>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Borrowed Date</th>
                            <th>Due Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.BorrowRecords.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted">No borrow history found.</td></tr>
                        }
                        @foreach(var record in Model.BorrowRecords.OrderByDescending(r => r.BorrowDate))
                        {
                            <tr>
                                <td>@(record.Student?.Name ?? "Unknown")</td>
                                <td>@record.BorrowDate.ToShortDateString()</td>
                                <td>@record.DueDate.ToShortDateString()</td>
                                <td>
                                    @if(record.Status == "Borrowed")
                                    {
                                        <span class="badge bg-warning text-dark">Borrowed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">Returned</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="mt-3">
                <a asp-action="Index" class="btn btn-outline-secondary">Back to Library</a>
            </div>
        }
    </div>
</div>
