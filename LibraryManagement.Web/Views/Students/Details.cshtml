@model LibraryManagement.Web.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<div class="row mt-4">
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm border-0">
            <div class="card-body text-center pt-5 pb-4">
                <i class="fa fa-user-circle text-muted mb-3" style="font-size: 8rem;"></i>
                <h3 class="fw-bold text-dark mb-0">@Model.Name</h3>
                <p class="text-muted">@Model.RegistrationNumber</p>
                
                <div class="d-grid gap-2 mt-4">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-dark"><i class="fa fa-edit"></i> Edit Profile</a>
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to Directory</a>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-0 pt-4 pb-0">
                <h5 class="fw-bold text-primary"><i class="fa fa-address-card"></i> Contact Information</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-sm-3 fw-bold text-muted">Email</div>
                    <div class="col-sm-9">
                        <a href="mailto:@Model.Email">@Model.Email</a>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-3 fw-bold text-muted">Phone</div>
                    <div class="col-sm-9">
                        <a href="tel:@Model.Phone">@Model.Phone</a>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-3 fw-bold text-muted">Address</div>
                    <div class="col-sm-9">@Model.Address</div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-0 pt-4 pb-0">
                <h5 class="fw-bold text-success"><i class="fa fa-book-reader"></i> Borrowing History</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Book Title</th>
                                <th>Borrowed</th>
                                <th>Due</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.BorrowRecords.Any())
                            {
                                <tr><td colspan="4" class="text-center text-muted py-3">No borrow history found for this student.</td></tr>
                            }
                            @foreach(var record in Model.BorrowRecords.OrderByDescending(r => r.BorrowDate))
                            {
                                <tr>
                                    <td class="fw-bold">@(record.Book?.Title ?? "Unknown")</td>
                                    <td>@record.BorrowDate.ToShortDateString()</td>
                                    <td>@record.DueDate.ToShortDateString()</td>
                                    <td>
                                        @if(record.Status == "Borrowed")
                                        {
                                            <span class="badge bg-warning text-dark">Borrowed</span>
                                        }
                                        else if(record.Status == "Returned")
                                        {
                                            <span class="badge bg-primary">Returned</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@record.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
