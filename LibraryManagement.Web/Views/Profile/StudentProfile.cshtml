@model LibraryManagement.Web.Models.Student

@{
    ViewData["Title"] = "My Profile";
}

<div class="row mt-4 justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-info text-white border-0 pt-4 pb-0 text-center">
                <i class="fa fa-user-graduate mb-3" style="font-size: 5rem;"></i>
                <h3 class="fw-bold mb-0">@Model.Name</h3>
                <p class="text-light opacity-75">Student</p>
            </div>
            
            <div class="card-body p-5">
                <div class="row mb-4">
                    <div class="col-sm-4 fw-bold text-muted text-uppercase">Registration No.</div>
                    <div class="col-sm-8 fs-5 text-primary fw-bold">@Model.RegistrationNumber</div>
                </div>
                <hr />
                <div class="row mb-4">
                    <div class="col-sm-4 fw-bold text-muted text-uppercase">Email Address</div>
                    <div class="col-sm-8">@Model.Email</div>
                </div>
                <hr />
                <div class="row mb-4">
                    <div class="col-sm-4 fw-bold text-muted text-uppercase">Phone Number</div>
                    <div class="col-sm-8">@Model.Phone</div>
                </div>
                <hr />
                <div class="row mb-4">
                    <div class="col-sm-4 fw-bold text-muted text-uppercase">Address</div>
                    <div class="col-sm-8">@Model.Address</div>
                </div>
            </div>
        </div>
    </div>
</div>
