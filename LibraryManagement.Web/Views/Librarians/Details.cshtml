@model LibraryManagement.Web.Models.Librarian

@{
    ViewData["Title"] = "Librarian Details";
}

<div class="row mt-4 justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white border-0 pt-4 pb-0 text-center">
                <i class="fa fa-user-shield mb-3" style="font-size: 5rem;"></i>
                <h3 class="fw-bold mb-0">@Model.Name</h3>
                <p class="text-light opacity-75">Administrator / Librarian</p>
            </div>
            
            <div class="card-body p-5">
                <div class="row mb-4">
                    <div class="col-sm-4 fw-bold text-muted text-uppercase">Employee ID</div>
                    <div class="col-sm-8 fs-5 text-primary fw-bold">@Model.EmployeeId</div>
                </div>
                <hr />
                <div class="row mb-4">
                    <div class="col-sm-4 fw-bold text-muted text-uppercase">Email Address</div>
                    <div class="col-sm-8">
                        <a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a>
                    </div>
                </div>
                <hr />
                <div class="row mb-4">
                    <div class="col-sm-4 fw-bold text-muted text-uppercase">Phone Number</div>
                    <div class="col-sm-8">
                        <a href="tel:@Model.Phone" class="text-decoration-none">@Model.Phone</a>
                    </div>
                </div>
                <hr />
                <div class="row mb-4">
                    <div class="col-sm-4 fw-bold text-muted text-uppercase">Age</div>
                    <div class="col-sm-8">@Model.Age years old</div>
                </div>
                
                <div class="d-flex justify-content-between mt-5">
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fa fa-arrow-left"></i> Back to Staff Directory</a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4"><i class="fa fa-edit"></i> Edit Profile</a>
                </div>
            </div>
        </div>
    </div>
</div>
